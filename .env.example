# Copy this file to ".env" for local development. Never commit ".env".
# On GitHub, add the same values as repository secrets
# (Settings > Secrets and variables > Actions).

# Vimeo player URL of the reel, set to "Unlisted" on Vimeo.
# Example: https://player.vimeo.com/video/123456789?h=abcdef1234
REEL_URL=

# Password visitors can type to unlock the reel.
REEL_PASSWORD=

# One private link per application: label=token, comma separated.
# Generate them with: npm run reel -- link company-name
# Link format: https://kevinrosso.me/#reel=<token>
REEL_LINK_TOKENS=

# Optional generic private link (tracked as "generic").
REEL_LINK_TOKEN=

# Contact email shown in the Contacts section. It is kept out of the repository and out of
# the page source (revealed only to real visitors). Without it the email link is not shown.
CONTACT_EMAIL=
