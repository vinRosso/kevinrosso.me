---
import { Image } from 'astro:assets';
import { postSlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, cover, draft } = post.data;
const href = `/blog/${postSlug(post)}/`;
---

<a class="tile" href={href}>
  {
    cover ? (
      <Image src={cover} alt="" widths={[500, 800]} sizes="(max-width: 991px) 90vw, 30vw" />
    ) : (
      <span class="tile-empty" />
    )
  }
  <span class="shade"></span>
  {import.meta.env.DEV && draft && <span class="draft">Draft</span>}
  <span class="caption">
    <span class="tile-title">{title}</span>
    <span class="tile-desc">{description}</span>
  </span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9; /* same ratio as the cover on the post page */
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface);
    color: #fff;
    text-decoration: none;
  }

  .tile :global(img),
  .tile-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tile-empty {
    background: linear-gradient(135deg, #2a2a2a, #161616);
  }

  .shade {
    position: absolute;
    inset: 0;
    /* Eased (smoothstep) fade rather than a straight line, so there is no visible edge */
    background: linear-gradient(
      to top,
      rgb(16 16 16 / 0.95) 0%,
      rgb(16 16 16 / 0.923) 8%,
      rgb(16 16 16 / 0.851) 16%,
      rgb(16 16 16 / 0.745) 24%,
      rgb(16 16 16 / 0.616) 32%,
      rgb(16 16 16 / 0.475) 40%,
      rgb(16 16 16 / 0.334) 48%,
      rgb(16 16 16 / 0.205) 56%,
      rgb(16 16 16 / 0.099) 64%,
      rgb(16 16 16 / 0.027) 72%,
      transparent 80%
    );
  }

  .draft {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--red);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 8px;
    padding: 22px 24px 24px;
  }

  .tile-title {
    justify-self: start;
    padding-bottom: 4px;
    border-bottom: 3px solid var(--red);
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .tile-desc {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    font-weight: 400;
    line-height: 1.35;
    transition: max-height 0.35s ease, opacity 0.35s ease;
  }

  .tile:hover :global(img),
  .tile:focus-visible :global(img) {
    transform: scale(1.06);
  }

  .tile:hover .tile-desc,
  .tile:focus-visible .tile-desc {
    max-height: 6em;
    opacity: 1;
  }

  /* No hover on touch screens: always show the description */
  @media (hover: none) {
    .tile-desc {
      max-height: 6em;
      opacity: 1;
    }
  }
</style>
