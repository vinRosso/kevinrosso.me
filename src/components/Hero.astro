---
import { Image } from 'astro:assets';
import profile from '../assets/profile-l.webp';
import { site } from '../data/site';
---

<section id="landing" class="hero">
  <div class="presentation">
    <p class="hello">Hi, my name is</p>
    <h1 class="full-name">
      <span class="first">{site.firstName}</span>
      <span class="last">{site.lastName}</span>
      <span class="visually-hidden"> - {site.role}</span>
    </h1>
    <p class="role">I'm an experienced <strong>{site.role.toUpperCase()}</strong></p>
    {
      site.availability && (
        <div class="cta">
          <p class="availability">
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              <path d="M12 12v.01" />
              <path d="M3 13a20 20 0 0 0 18 0" />
            </svg>
            {site.availability}
          </p>
          <p class="actions">
            <a class="btn btn--solid" href="#contacts">Get in touch</a>
            <a class="btn" href="#about">See my work</a>
          </p>
        </div>
      )
    }
  </div>

  <Image
    src={profile}
    alt={`Portrait of ${site.name}`}
    class="profile-pic"
    widths={[500, 800, 1080].filter((w) => w < profile.width).concat(profile.width)}
    sizes="(max-width: 479px) 75vw, 50vw"
    loading="eager"
    fetchpriority="high"
  />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .presentation {
    position: absolute;
    z-index: 3;
    left: 15vw;
    top: 40vh;
  }

  .hello {
    font-size: clamp(1.6rem, 3vw, 3rem);
    font-weight: 200;
    line-height: 1;
  }

  .full-name {
    margin: 20px 0 20px -5px;
    font-size: clamp(4rem, 8vw, 8.5rem);
    font-weight: 700;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .full-name span {
    display: block;
  }

  .full-name .last {
    color: var(--red);
    font-weight: 400;
  }

  .role {
    font-size: clamp(1.1rem, 2vw, 2rem);
    font-weight: 200;
  }

  .role strong {
    font-size: 0.9em;
    font-weight: 400;
    transition: color 0.2s;
  }

  .role strong:hover {
    color: var(--red-soft);
  }

  .cta {
    display: grid;
    gap: 18px;
    margin-top: 34px;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    font-weight: 300;
    /* Dark rounded outline so the lines behind don't hinder reading */
    filter: url(#halo-sm);
  }

  .availability .icon {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .profile-pic {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: auto;
    height: 100%;
    max-width: 55%;
    object-fit: cover;
    object-position: left bottom;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.028) 1.8%,
      rgb(0 0 0 / 0.104) 3.6%,
      rgb(0 0 0 / 0.216) 5.4%,
      rgb(0 0 0 / 0.352) 7.2%,
      rgb(0 0 0 / 0.500) 9%,
      rgb(0 0 0 / 0.648) 10.8%,
      rgb(0 0 0 / 0.784) 12.6%,
      rgb(0 0 0 / 0.896) 14.4%,
      rgb(0 0 0 / 0.972) 16.2%,
      #000 18%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.028) 1.8%,
      rgb(0 0 0 / 0.104) 3.6%,
      rgb(0 0 0 / 0.216) 5.4%,
      rgb(0 0 0 / 0.352) 7.2%,
      rgb(0 0 0 / 0.500) 9%,
      rgb(0 0 0 / 0.648) 10.8%,
      rgb(0 0 0 / 0.784) 12.6%,
      rgb(0 0 0 / 0.896) 14.4%,
      rgb(0 0 0 / 0.972) 16.2%,
      #000 18%
    );
  }

  @media (max-width: 991px) {
    .presentation {
      top: 22vh;
      left: 10vw;
    }

    .profile-pic {
      height: auto;
      max-height: 70svh;
      max-width: 85%;
      -webkit-mask-image: linear-gradient(
        to top,
        #000 70%,
        rgb(0 0 0 / 0.972) 73%,
        rgb(0 0 0 / 0.896) 76%,
        rgb(0 0 0 / 0.784) 79%,
        rgb(0 0 0 / 0.648) 82%,
        rgb(0 0 0 / 0.500) 85%,
        rgb(0 0 0 / 0.352) 88%,
        rgb(0 0 0 / 0.216) 91%,
        rgb(0 0 0 / 0.104) 94%,
        rgb(0 0 0 / 0.028) 97%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to top,
        #000 70%,
        rgb(0 0 0 / 0.972) 73%,
        rgb(0 0 0 / 0.896) 76%,
        rgb(0 0 0 / 0.784) 79%,
        rgb(0 0 0 / 0.648) 82%,
        rgb(0 0 0 / 0.500) 85%,
        rgb(0 0 0 / 0.352) 88%,
        rgb(0 0 0 / 0.216) 91%,
        rgb(0 0 0 / 0.104) 94%,
        rgb(0 0 0 / 0.028) 97%,
        transparent 100%
      );
    }
  }

  @media (max-width: 479px) {
    .presentation {
      top: 12vh;
      left: 10vw;
    }

    .full-name {
      margin: 10px 0;
      font-size: 18vw;
    }

    .hello {
      font-size: 7vw;
    }

    .role {
      font-size: 4.5vw;
    }

    .profile-pic {
      max-width: 80%;
    }
  }
</style>
