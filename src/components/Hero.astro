---
import { Image } from 'astro:assets';
import profile from '../assets/profile-l.webp';
import { site } from '../data/site';
---

<section id="landing" class="hero">
  <div class="presentation">
    <p class="hello">Hi, my name is</p>
    <h1 class="full-name">
      <span class="first">{site.firstName}</span>
      <span class="last">{site.lastName}</span>
      <span class="visually-hidden"> - {site.role}</span>
    </h1>
    <p class="role">I'm an experienced <strong>{site.role.toUpperCase()}</strong></p>
    {
      site.availability && (
        <div class="cta">
          <p class="availability">
            <span class="dot" aria-hidden="true" />
            {site.availability}
          </p>
          <p class="actions">
            <a class="btn btn--solid" href="#contacts">Get in touch</a>
            <a class="btn" href="#about">See my work</a>
          </p>
        </div>
      )
    }
  </div>

  <Image
    src={profile}
    alt={`Portrait of ${site.name}`}
    class="profile-pic"
    widths={[500, 800, 1080].filter((w) => w < profile.width).concat(profile.width)}
    sizes="(max-width: 479px) 75vw, 50vw"
    loading="eager"
    fetchpriority="high"
  />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .presentation {
    position: absolute;
    z-index: 3;
    left: 15vw;
    top: 40vh;
  }

  .hello {
    font-size: clamp(1.6rem, 3vw, 3rem);
    font-weight: 200;
    line-height: 1;
  }

  .full-name {
    margin: 20px 0 20px -5px;
    font-size: clamp(4rem, 8vw, 8.5rem);
    font-weight: 700;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .full-name span {
    display: block;
  }

  .full-name .last {
    color: var(--red);
    font-weight: 400;
  }

  .role {
    font-size: clamp(1.1rem, 2vw, 2rem);
    font-weight: 200;
  }

  .role strong {
    font-size: 0.9em;
    font-weight: 400;
    transition: color 0.2s;
  }

  .role strong:hover {
    color: var(--red-soft);
  }

  .cta {
    display: grid;
    gap: 18px;
    margin-top: 34px;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    font-weight: 300;
    /* Dark rounded outline so the lines behind don't hinder reading */
    filter: url(#halo-sm);
  }

  .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #4cc38a;
    box-shadow: 0 0 0 4px rgb(76 195 138 / 0.25);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .profile-pic {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: auto;
    height: 100%;
    max-width: 55%;
    object-fit: cover;
    object-position: left bottom;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%);
    mask-image: linear-gradient(to right, transparent, #000 18%);
  }

  @media (max-width: 991px) {
    .presentation {
      top: 22vh;
      left: 10vw;
    }

    .profile-pic {
      height: auto;
      max-height: 70svh;
      max-width: 85%;
      -webkit-mask-image: linear-gradient(to top, #000 70%, transparent);
      mask-image: linear-gradient(to top, #000 70%, transparent);
    }
  }

  @media (max-width: 479px) {
    .presentation {
      top: 12vh;
      left: 10vw;
    }

    .full-name {
      margin: 10px 0;
      font-size: 18vw;
    }

    .hello {
      font-size: 7vw;
    }

    .role {
      font-size: 4.5vw;
    }

    .profile-pic {
      max-width: 80%;
    }
  }
</style>
