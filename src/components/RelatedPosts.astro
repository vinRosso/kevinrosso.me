---
import PostCard from './PostCard.astro';
import { getListedPosts, tagSlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const mine = new Set(post.data.tags.map(tagSlug));
const others = (await getListedPosts()).filter((p) => p.id !== post.id);

// Most shared tags first, then newest (the list is already newest first).
const scored = others
  .map((p) => ({ p, shared: p.data.tags.filter((t) => mine.has(tagSlug(t))).length }))
  .sort((a, b) => b.shared - a.shared);

const related = scored.filter((x) => x.shared > 0).map((x) => x.p);
// Not enough in common: complete with the newest posts so the reader always has somewhere to go.
const posts = [...related, ...others.filter((p) => !related.includes(p))].slice(0, 3);
const title = related.length > 0 ? 'Related posts' : 'More posts';
---

{
  posts.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">{title}</h2>
      <div class="grid" style={`--n: ${posts.length}`}>
        {posts.map((p) => (
          <PostCard post={p} />
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    margin-top: 72px;
    padding: 28px;
    border-radius: 10px;
    background: var(--surface);
  }

  h2 {
    margin-bottom: 20px;
    font-size: 1.4rem;
  }

  /* Compact tiles: this is a footer aside, not a gallery */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 230px));
    gap: 14px;
  }

  .grid :global(.tile) {
    aspect-ratio: 16 / 9;
  }

  .grid :global(.caption) {
    padding: 12px 14px 14px;
    gap: 6px;
  }

  .grid :global(.tile-title) {
    font-size: 0.95rem;
    border-bottom-width: 2px;
    padding-bottom: 3px;
  }

  .grid :global(.tile-desc) {
    font-size: 0.8rem;
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
