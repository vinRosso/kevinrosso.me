---
import { site } from '../data/site';

const socials = site.socials.filter((s) => s.href);

// The address is not in the repository nor in the page source: it is read at build time and
// shipped scrambled (reversed + base64). The script below unscrambles it when a real visitor
// first moves the mouse, touches the screen or presses a key, so crawlers never see it.
const email = ((import.meta.env.CONTACT_EMAIL ?? process.env.CONTACT_EMAIL ?? '') as string).trim();
const scrambled = email ? Buffer.from([...email].reverse().join('')).toString('base64') : '';
const linkedin = socials.find((s) => s.icon === 'linkedin')?.href;
if (!email) console.warn('[contacts] CONTACT_EMAIL is not set: the email link will not be shown.');
---

<section id="contacts" class="contacts">
  <h2 class="lead">Let's work together</h2>
  {
    scrambled && (
      <>
        <a class="mail" href="#contacts" data-mail={scrambled}>
          Email me
        </a>
        <noscript>
          <p class="mail-note">
            Turn on JavaScript to see my email address{linkedin && <>, or write to me on <a href={linkedin}>LinkedIn</a></>}.
          </p>
        </noscript>
      </>
    )
  }

  <ul class="social-list">
    {
      socials.map((s) => (
        <li>
          <a class="social-link" href={s.href} target="_blank" rel="noopener me" aria-label={s.label}>
            <img src={`/icons/${s.icon}.svg`} alt="" width="64" height="64" loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>

  <p class="copy">&copy; {new Date().getFullYear()} {site.name}</p>
</section>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-mail]');
  if (link) {
    const reveal = () => {
      if (!link.dataset.mail) return;
      const address = [...atob(link.dataset.mail)].reverse().join('');
      link.textContent = address;
      link.href = `mailto:${address}`;
      delete link.dataset.mail;
      events.forEach((e) => removeEventListener(e, reveal));
    };
    const events = ['pointermove', 'pointerdown', 'touchstart', 'keydown'];
    events.forEach((e) => addEventListener(e, reveal, { passive: true }));
    // Clicking "Email me" before anything else has moved: show it instead of jumping.
    link.addEventListener('click', (ev) => {
      if (link.dataset.mail) {
        ev.preventDefault();
        reveal();
      }
    });
  }
</script>

<style>
  .contacts {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 100px var(--gutter) calc(var(--nav-h) + 48px);
  }

  .contacts > * {
    position: relative;
    z-index: 2;
  }

  .contacts .lead {
    -webkit-text-stroke: 0;
    filter: url(#halo-lg);
  }

  /* Dark outline (background colour) around texts and icons, so the
     lines passing behind them don't get in the way of reading. */
  .mail {
    color: #fff;
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 300;
    text-underline-offset: 5px;
    filter: url(#halo-lg);
  }

  .mail-note {
    color: var(--muted);
    filter: url(#halo-sm);
  }

  .mail:hover {
    color: var(--red-soft);
  }

  .social-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(24px, 8vw, 120px);
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: block;
    /* Same corner radius for all icons (the three SVGs each round their corners
       differently); the dark cut-out around them follows it proportionally. */
    border-radius: 20%;
    background: var(--bg);
    box-shadow: 0 0 0 clamp(8px, 1.2vw, 14px) var(--bg);
    transition: transform 0.2s;
  }

  .social-link:hover {
    transform: translateY(-4px);
  }

  .social-link img {
    display: block;
    width: clamp(40px, 5vw, 64px);
    height: auto;
    border-radius: 20%;
  }

  .copy {
    margin-top: 24px;
    color: #5c5c5c;
    font-size: 0.8rem;
    filter: url(#halo-sm);
  }
</style>
