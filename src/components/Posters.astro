---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<div class="posters" data-posters>
  <button class="arrow prev" type="button" aria-label="Previous posters" data-prev>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"
      ><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2"></path></svg
    >
  </button>

  <ul class="track" data-track aria-label="Selected credits">
    {
      // Five copies for the infinite loop: only the middle one (2) is read
      // by screen readers, the others are visual clones.
      [0, 1, 2, 3, 4].map((copy) =>
        site.posters.map((p, i) => (
          <li class="poster" data-copy={copy} data-index={i} aria-hidden={copy === 2 ? undefined : 'true'}>
            <Image
              src={p.src}
              alt={copy === 2 ? p.title : ''}
              title={copy === 2 ? p.title : undefined}
              height={300}
              loading={copy === 2 ? 'eager' : 'lazy'}
            />
          </li>
        )),
      )
    }
  </ul>

  <button class="arrow next" type="button" aria-label="Next posters" data-next>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"
      ><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2"></path></svg
    >
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-posters]');
  const track = root?.querySelector<HTMLElement>('[data-track]');

  if (root && track) {
    const items = [...track.querySelectorAll<HTMLElement>('.poster')];
    const copyOf = (el: HTMLElement) => Number(el.dataset.copy);
    const byKey = (copy: number, index: number) =>
      track.querySelector<HTMLElement>(`.poster[data-copy="${copy}"][data-index="${index}"]`)!;

    // Scroll position that puts a poster exactly in the centre, measured on
    // the real layout (posters have different widths).
    const centreOf = (el: HTMLElement) => {
      const t = track.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return track.scrollLeft + (r.left + r.width / 2) - (t.left + track.clientLeft + track.clientWidth / 2);
    };

    // Poster currently closest to the centre.
    const nearest = () => {
      let best = items[0];
      let dist = Infinity;
      for (const el of items) {
        const d = Math.abs(centreOf(el) - track.scrollLeft);
        if (d < dist) {
          dist = d;
          best = el;
        }
      }
      return best;
    };

    // Width of one full set: identical copies, so this is exact.
    const setWidth = () => centreOf(byKey(3, 0)) - centreOf(byKey(2, 0));

    let animating = false;

    // Keep the view in the copies 1-3. If the poster in the centre belongs to
    // an outer copy (0 or 4), move to the same poster in the middle copy:
    // the copies are identical, so the jump is invisible, and after it the
    // view is a whole set away from the outer copies (no bouncing).
    const normalize = () => {
      if (animating) return;
      const copy = copyOf(nearest());
      if (copy === 0 || copy === 4) track.scrollLeft += (2 - copy) * setWidth();
    };

    // Thor (first poster of the middle copy) in the centre.
    const center = () => {
      track.scrollLeft = centreOf(byKey(2, 0));
    };

    // Custom smooth scroll with easing. The browser's scroll-snap is off
    // (it caused a small correction at the end): snapping is done here.
    const AUTO_DURATION = 1400;
    const ARROW_DURATION = 600;
    const SETTLE_DURATION = 350;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const animateTo = (to: number, duration: number) => {
      animating = true;
      const from = track.scrollLeft;
      const t0 = performance.now();
      const frame = (now: number) => {
        const p = Math.min(1, (now - t0) / duration);
        track.scrollLeft = from + (to - from) * ease(p);
        if (p < 1) requestAnimationFrame(frame);
        else {
          animating = false;
          normalize();
        }
      };
      requestAnimationFrame(frame);
    };

    const go = (dir: 1 | -1, duration: number) => {
      if (animating) return;
      normalize();
      const i = items.indexOf(nearest());
      const next = items[Math.min(items.length - 1, Math.max(0, i + dir))];
      animateTo(centreOf(next), duration);
    };

    // After a manual scroll (drag, wheel, trackpad) glide to the nearest poster.
    const settleToNearest = () => {
      if (animating) return;
      normalize();
      const to = centreOf(nearest());
      if (Math.abs(to - track.scrollLeft) > 1) animateTo(to, SETTLE_DURATION);
    };

    let settle: number | undefined;
    let touching = false;
    const onScroll = () => {
      if (animating) return;
      window.clearTimeout(settle);
      settle = window.setTimeout(() => !touching && settleToNearest(), 160);
    };
    track.addEventListener('scroll', onScroll, { passive: true });

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1, ARROW_DURATION));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(1, ARROW_DURATION));

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const start = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => go(1, AUTO_DURATION), 5000);
    };
    const stop = () => window.clearInterval(timer);
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    track.addEventListener('touchstart', () => ((touching = true), stop()), { passive: true });
    track.addEventListener('touchend', () => ((touching = false), onScroll(), start()), { passive: true });

    center();
    addEventListener('load', center, { once: true });
    new ResizeObserver(() => !animating && (track.scrollLeft = centreOf(nearest()))).observe(track);
    start();
  }
</script>

<style>
  .posters {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .track {
    display: flex;
    gap: clamp(16px, 4vw, 56px);
    margin: 0;
    padding: 8px 4px;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .poster {
    flex: 0 0 auto;
  }

  .poster :global(img) {
    width: auto;
    height: clamp(120px, 22vh, 260px);
    border-radius: 2px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.5);
  }

  .arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .arrow:hover {
    color: var(--red-soft);
  }

  @media (max-width: 479px) {
    .arrow {
      display: none;
    }
  }
</style>
