---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="lost">
    <p class="code">404</p>
    <h1 class="title">This page has gone off-rig</h1>
    <p class="text">The page you are looking for does not exist or has moved.</p>
    <p class="actions">
      <a class="btn btn--solid" href="/">Back to the home page</a>
      <a class="btn" href="/blog/">Read the blog</a>
    </p>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 120px var(--gutter) calc(var(--nav-h) + 40px);
    text-align: center;
  }

  .code {
    color: var(--red);
    font-size: clamp(5rem, 16vw, 11rem);
    font-weight: 700;
    line-height: 1;
    filter: url(#halo-lg);
  }

  .title {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 200;
    filter: url(#halo-lg);
  }

  .text {
    color: var(--muted);
    filter: url(#halo-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
